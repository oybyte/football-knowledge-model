# ============================================================================
# odds-edge 编排环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env   （Windows: copy .env.example .env）
# docker compose 会自动读取同目录 .env 注入 compose/容器。
# ============================================================================

# ---- 网关鉴权 ----
# 设置后（非空）所有受保护 API 需携带 X-Api-Key 头（或 ?api_key= 参数）才可访问；
# 留空 = 开发模式，跳过鉴权（auth_disabled）。
# 单 Key（兼容）：OE_API_KEY=my-secret-key
# 多 Key（推荐，逗号分隔，任一有效即可）：OE_API_KEYS=key-a,key-b
# 撤销 Key（逗号分隔）：命中撤销列表的 Key 返回 403 forbidden（已认证但无权限）
# 密钥可用明文，也可用 sha256 哈希（前缀 sha256:<hex>）——配置/日志不落明文。
# 例：OE_API_KEY=sha256:<openssl dgst -sha256 输出的 hex>
OE_API_KEY=
# OE_API_KEYS=
# OE_API_KEY_REVOKED=

# ---- 网关 TLS 终止（可选）----
# 证书/私钥文件路径同设即启用 HTTPS（终止 TLS）；缺任一则忽略并告警（仍 HTTP）。
# 生产建议由负载均衡/反向代理终止 TLS；直连后端时也可用它加密。
# OE_TLS_CERT=
# OE_TLS_KEY=

# ---- 网关限流（可选）----
# 内存固定窗口：单客户端每窗口最多 max 次请求，超限返回 429 + Retry-After。
# 默认 300 次 / 60s；max<=0 禁用。
# 单实例默认 OE_RATE_LIMIT_STORE=memory；多实例共享限流计数设为 redis（需 OE_REDIS_URL 已接线）
# OE_RATE_LIMIT_MAX=300
# OE_RATE_LIMIT_WINDOW_MS=60000
# OE_RATE_LIMIT_STORE=memory

# ---- 数字落库路径（容器内绝对路径，挂载 oe-data 卷持久化）----
# 默认值见 docker-compose.yml，通常无需修改
# OE_DB_PATH=/app/data/odds-edge.db

# ---- 真实数据源（可选，留空则退回可用的内建/官方数据）----
# 本地人工盘赔目录：填宿主机源目录（如 D:\ocr_python_data\FootballScreenshotOcr\output），
# compose 会 bind-mount 进容器 /tmp/manual-odds 供后端读取（见 docker-compose.yml）。
# 注意：后端在容器内固定读 /tmp/manual-odds，此处宿主机路径仅用于 bind 挂载。
# OE_MANUAL_ODDS_ROOT=<宿主机盘口源目录>
# 竞彩官方赛程接口（默认已内置），一般无需设置
# ODDS_SPORTTERY_SCHEDULE_BASE=
# ODDS_SPORTTERY_ODDS_BASE=

# ---- 时区 ----
TZ=Asia/Shanghai